# Токен бота, выданный @BotFather в Telegram
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Telegram chat_id менеджера (или группы поддержки), куда бот шлёт
# сообщения "пользователь застрял на шаге X" и запросы связи с человеком.
# Узнать свой chat_id: написать боту @userinfobot и скопировать поле Id.
MANAGER_CHAT_ID=123456789

# Необязательно: текст, который бот показывает как телефон/почту компании
# на случай, если MANAGER_CHAT_ID не настроен или менеджер не отвечает.
COMPANY_PHONE=+7 (904) 797-94-20
COMPANY_PHONE_2=+7 (831) 275-89-49
COMPANY_EMAIL=progress@komandir-nn.ru
