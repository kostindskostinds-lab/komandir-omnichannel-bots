# Токен бота MAX — получить у MasterBot (аналог BotFather в Telegram): напишите
# ему в MAX и следуйте инструкции создания бота, он пришлёт токен.
BOT_TOKEN=

# Куда бот будет слать сообщения о застрявших пользователях (кнопка "Позвать
# менеджера"). Заполните ОДНО из двух — если задан MANAGER_CHAT_ID, он в
# приоритете над MANAGER_USER_ID.
#
# MANAGER_CHAT_ID — групповой чат (рекомендуется, если заявки должны видеть
# несколько человек). Чтобы узнать ID: создайте в MAX групповой чат (или
# возьмите существующий), добавьте туда этого бота как участника — он сам
# сразу напишет в чат свой ID, скопируйте его сюда.
MANAGER_CHAT_ID=

# MANAGER_USER_ID — личный user_id одного конкретного сотрудника (если чат не
# нужен, а заявки должен видеть только он). Чтобы узнать user_id — временно
# добавьте в src/bot.js в любой обработчик console.log(ctx.user) и посмотрите
# поле user_id в консоли после того, как напишете боту.
#
# Если оставить оба поля пустыми — бот просто покажет пользователю телефон и
# почту вместо пересылки менеджеру.
MANAGER_USER_ID=

# Запасные контакты (уже заполнены реальными данными магазина на Кащенко, 6г,
# можно поменять).
COMPANY_PHONE=+7 (904) 797-94-20
COMPANY_PHONE_2=+7 (831) 275-89-49
COMPANY_EMAIL=progress@komandir-nn.ru
